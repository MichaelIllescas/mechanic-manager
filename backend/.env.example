# Copiá este archivo como .env y completá los valores.
# El .env es local y nunca se commitea.

# Clave HMAC para firmar los JWT. Mínimo 32 bytes en base64.
# Generar con:
#   $b = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=

# Minutos de validez del token de acceso.
JWT_EXPIRATION_MINUTES=60

# SMTP Hostinger
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=Mechanic Manager
FRONTEND_BASE_URL=http://localhost:4200

# Ruta del frontend que recibe el token de recuperacion
FRONTEND_RESET_PASSWORD_PATH=/reset-password

# Minutos de validez del enlace de recuperacion
PASSWORD_RESET_EXPIRATION_MINUTES=30

# Solo produccion: administrador inicial (SYSTEM_ADMIN). Se crea si no existe y
# se deshabilita la cuenta sembrada por la migracion V2. Clave: minimo 8 caracteres.
ADMIN_EMAIL=
ADMIN_PASSWORD=
